PREFIX cosai: <https://cosai-oasis.github.io/ontology/cosai-rm#>
PREFIX cre: <https://www.opencre.org/cre/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX dcterms: <http://purl.org/dc/terms/>

SELECT ?entry ?entryLabel ?cre ?creLabel ?via ?nativeId
WHERE {
  ?entry skos:relatedMatch ?cre ;
         rdfs:label ?entryLabel .
  FILTER(STRSTARTS(STR(?cre), "https://www.opencre.org/cre/"))
  OPTIONAL { ?cre skos:prefLabel ?creLabel }
  OPTIONAL {
    ?assertion a cosai:AlignmentAssertion ;
               cosai:alignmentSubject ?entry ;
               cosai:alignmentObject ?cre ;
               cosai:alignmentVia ?via ;
               dcterms:source ?nativeId .
  }
}
ORDER BY ?entryLabel ?cre
