    dcterms:identifier "agent" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/actor-access.yaml> .

cosai:access_supply_chain a cosai:ActorAccessLevel ;
    rdfs:label "Supply Chain Position"@en ;
    rdfs:comment "Actors positioned in the software, data, or model supply chain (e.g., data providers, model vendors)"@en ;
    dcterms:identifier "supply-chain" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/actor-access.yaml> .

cosai:access_infrastructure_provider a cosai:ActorAccessLevel ;
    rdfs:label "Infrastructure Provider"@en ;
    rdfs:comment "Cloud or infrastructure providers with access to underlying systems (e.g., hypervisor, storage)"@en ;
    dcterms:identifier "infrastructure-provider" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/actor-access.yaml> .

cosai:access_service_provider a cosai:ActorAccessLevel ;
    rdfs:label "Service Provider"@en ;
    rdfs:comment "Third-party service providers with access to systems or data (e.g., ML platforms, annotation services)"@en ;
    dcterms:identifier "service-provider" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/actor-access.yaml> .

cosai:access_physical a cosai:ActorAccessLevel ;
    rdfs:label "Physical Access"@en ;
    rdfs:comment "Attackers with physical access to hardware, facilities, or devices"@en ;
    dcterms:identifier "physical" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/actor-access.yaml> .

cosai:personaModelProvider a cosai:Persona ;
    rdfs:label "Model Provider"@en ;
    rdfs:comment "Actors that develop, train, evaluate, and tune AI/ML models (foundation models, specialized models, or domain-adapted models). This includes those that develop models from scratch or significantly modify existing models for distribution. This also includes model aggregators, model marketplaces, and those licensing models. Actors that also operate runtime environments serving model predictions are additionally covered by AI Model Serving."@en ;
    dcterms:identifier "personaModelProvider" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaDataProvider a cosai:Persona ;
    rdfs:label "Data Provider"@en ;
    rdfs:comment "Actors that supply training data, evaluation datasets, or inference data to model providers or application developers. This includes data aggregators, data marketplaces, and those licensing datasets."@en ;
    dcterms:identifier "personaDataProvider" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaPlatformProvider a cosai:Persona ;
    rdfs:label "AI Platform Provider"@en ;
    rdfs:comment "Actors that provide infrastructure, compute resources, APIs, and platform services for AI model hosting, training, or inference. This includes internal infrastructure teams, cloud providers (AWS, Azure, GCP), MLOps platforms, and platform-level API gateway services (e.g., load balancing, API authentication, and request throttling layers)."@en ;
    dcterms:identifier "personaPlatformProvider" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaModelServing a cosai:Persona ;
    rdfs:label "AI Model Serving"@en ;
    rdfs:comment "The entity responsible for provisioning, managing, and securing the runtime environment that serves AI and ML model predictions at scale. This persona covers all model types , including classical ML, statistical, optimization, and generative AI models , focusing on the secure execution of predictions, ensuring runtime integrity, confidentiality, and availability of data and outputs. It separates its duties from model training, tuning, or registry storage (Model Provider) and physical infrastructure management (AI Platform Provider), focusing on the secure orchestration and delivery of the model serving application layer."@en ;
    dcterms:identifier "personaModelServing" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaAgenticProvider a cosai:Persona ;
    rdfs:label "Agentic Platform and Framework Providers"@en ;
    rdfs:comment "Actors that provide the development environments, software frameworks, and orchestration runtimes required to implement agentic reasoning, planning, and tool execution. Examples include agentic frameworks and libraries (e.g., LangChain, Semantic Kernel), agent-native development environments (e.g., Cursor, GitHub Copilot Workspace), and managed agent orchestration platforms (e.g., Vertex AI Agent Builder, OpenAI Assistants API)."@en ;
    dcterms:identifier "personaAgenticProvider" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaApplicationDeveloper a cosai:Persona ;
    rdfs:label "Application Developer"@en ;
    rdfs:comment "Actors that integrate AI models (via APIs or embedded models) into applications, products, or services. They may consume models without modifying them, or perform light customization (prompt engineering, RAG, etc.)."@en ;
    dcterms:identifier "personaApplicationDeveloper" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaGovernance a cosai:Persona ;
    rdfs:label "AI System Governance"@en ;
    rdfs:comment "Actors responsible for defining security control objectives, measuring implementations, and enforcing compliance for AI systems across the AI system lifecycle. This includes AI risk officers, compliance teams, and governance boards."@en ;
    dcterms:identifier "personaGovernance" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaEndUser a cosai:Persona ;
    rdfs:label "AI System Users"@en ;
    rdfs:comment "Actors that use AI-powered applications or services without developing or deploying the AI components themselves. Users rely on application developers and providers for AI security controls."@en ;
    dcterms:identifier "personaEndUser" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> .

cosai:personaModelCreator a cosai:Persona ;
    rdfs:label "Model Creator (Legacy)"@en ;
    rdfs:comment "DEPRECATED: This persona has been superseded by more specific personas. Use Model Provider for those that train/tune models, or Application Developer for those integrating models into applications. Organizations that either train and tune foundation models for Generative AI, or tune acquired models for more domain-specific tasks."@en ;
    dcterms:identifier "personaModelCreator" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> ;
    owl:deprecated true .

cosai:personaModelConsumer a cosai:Persona ;
    rdfs:label "Model Consumer (Legacy)"@en ;
    rdfs:comment "DEPRECATED: Use Application Developer or AI System Users depending on context. Organizations that build AI applications, features, or products using models, but do not create or tune the models themselves. The models may be accessed via an API to a managed service, or downloaded and packaged into the application or product being produced."@en ;
    dcterms:identifier "personaModelConsumer" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/personas.yaml> ;
    owl:deprecated true .

cosai:componentDataSources a cosai:InfrastructureComponent, cosai:Component ;
    rdfs:label "Data Sources"@en ;
    rdfs:comment "The original sources or repositories from which data is gathered for potential use in training an AI model. These can include databases, APIs, web scraping, or even sensor data. The quality and diversity of data sources significantly impact the model's capabilities."@en ;
    dcterms:identifier "componentDataSources" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentDataFilteringAndProcessing .

cosai:componentDataFilteringAndProcessing a cosai:InfrastructureComponent, cosai:Component ;
    rdfs:label "Data Filtering and Processing"@en ;
    rdfs:comment "The processes of cleaning, transforming, and preparing raw data from various sources to make it suitable for training. This may include labeling data, removing duplicates or errors, and even generating new synthetic data to enhance the model's learning."@en ;
    dcterms:identifier "componentDataFilteringAndProcessing" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentTrainingData ;
    cosai:fedBy cosai:componentDataSources .

cosai:componentTrainingData a cosai:InfrastructureComponent, cosai:Component ;
    rdfs:label "Training Data"@en ;
    rdfs:comment "The final, curated subset of data that is fed into the AI model during the training process. This data is used to adjust the model's internal parameters, enabling it to learn patterns and make predictions or inferences."@en ;
    dcterms:identifier "componentTrainingData" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentDataStorage ;
    cosai:fedBy cosai:componentDataFilteringAndProcessing .

cosai:componentDataStorage a cosai:InfrastructureComponent, cosai:Component ;
    rdfs:label "Data Storage Infrastructure"@en ;
    rdfs:comment "Storage for training data. Training data is stored from ingestion through filtering and usage during training."@en ;
    dcterms:identifier "componentDataStorage" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentModelTrainingTuning ;
    cosai:fedBy cosai:componentTrainingData .

cosai:componentModelFrameworksAndCode a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Model Frameworks and Code"@en ;
    rdfs:comment "The code and frameworks necessary to train and use a model. Model code defines the model architecture and number and types of layers in the model. Framework code implements the steps for each layer to train and evaluate the model. The framework code is generally necessary not just for training a model, but also required to run inferences (i.e., make predictions) when the model is in use. Usually framework code is shipped separately from the model itself and needs to be installed to use the model."@en ;
    dcterms:identifier "componentModelFrameworksAndCode" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentModelTrainingTuning .

cosai:componentModelEvaluation a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Model Evaluation"@en ;
    rdfs:comment "The process of testing the model against new data to see how well it performs (evaluation). Evaluation happens in two stages: during the training process, when each checkpointed update to the model is evaluated, and after the model is trained, to assess how well it performs at its intended purpose."@en ;
    dcterms:identifier "componentModelEvaluation" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentModelTrainingTuning ;
    cosai:fedBy cosai:componentTheModel .

cosai:componentModelTrainingTuning a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Training and Tuning"@en ;
    rdfs:comment "The process of teaching a model to extract the correct patterns and inferences from data by adjusting the probability of a given outcome (training) and adjusting a smaller set of probabilities to tune a model to a specific task (tuning). Given the enormous cost of training, many model creators take a preexisting model and tune it to their needs, by focusing only on the training related to a specific type of task."@en ;
    dcterms:identifier "componentModelTrainingTuning" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentTheModel ;
    cosai:fedBy cosai:componentModelEvaluation, cosai:componentModelFrameworksAndCode, cosai:componentDataStorage .

cosai:componentModelStorage a cosai:InfrastructureComponent, cosai:Component ;
    rdfs:label "Model Storage"@en ;
    rdfs:comment "Storage for the model. Model storage refers to multiple stages in the development process: Local storage during training, in which each checkpoint is stored until overwritten. Published storage, after training is completed and the model is uploaded to a model hub (a centralized model repository). Note: Many model consumers use remote models served by API. Those model consumers that store models themselves, though, should consider the same Model Storage risks that apply to model creators."@en ;
    dcterms:identifier "componentModelStorage" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentTheModel .

cosai:componentModelServing a cosai:InfrastructureComponent, cosai:Component ;
    rdfs:label "Model Serving Infrastructure"@en ;
    rdfs:comment "The systems and process to deploy a model in production, making them available for services and applications. Note: Many model consumers use remote models served via API. Those that serve their own models, though, should consider the same Model Serving risks that apply to model creators."@en ;
    dcterms:identifier "componentModelServing" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentTheModel .

cosai:componentTheModel a cosai:ModelComponent, cosai:Component ;
    rdfs:label "The Model"@en ;
    rdfs:comment "A pairing of code and weights, created with data during a training process. In the CoSAI Risk Map, the model is represented as the result of the output of the Data Components being trained, stored, and served using the Infrastructure Components. A model is ultimately useful when deployed in applications, using Application Components."@en ;
    dcterms:identifier "componentTheModel" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentModelEvaluation, cosai:componentAgentInputHandling, cosai:componentApplicationInputHandling, cosai:componentOrchestrationInputHandling ;
    cosai:fedBy cosai:componentModelTrainingTuning, cosai:componentModelServing, cosai:componentModelStorage, cosai:componentAgentOutputHandling, cosai:componentApplicationOutputHandling, cosai:componentOrchestrationOutputHandling .

cosai:componentApplication a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Application"@en ;
    rdfs:comment "The application, product, or feature that uses an AI model for functionality. These applications might be directly user-facing, as in the case of a customer service chatbot, or the “user” might be a service within an organization, querying the model to power an upstream process. If an application has the ability to execute tools on behalf of its user, it is sometimes referred to as an Agent."@en ;
    dcterms:identifier "componentApplication" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentApplicationOutputHandling, cosai:componentAgentInputHandling ;
    cosai:fedBy cosai:componentApplicationInputHandling, cosai:componentAgentOutputHandling .

cosai:componentApplicationOutputHandling a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Output Handling"@en ;
    rdfs:comment "Similar to input handling, output handling components filter, sanitize, and protect against unwanted, unexpected or dangerous outputs from a model. Output handling is a major line of defense against various risks and an area primed for more development."@en ;
    dcterms:identifier "componentApplicationOutputHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentTheModel ;
    cosai:fedBy cosai:componentApplication .

cosai:componentApplicationInputHandling a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Input Handling"@en ;
    rdfs:comment "Input handling components filter, sanitize, and protect against potentially malicious inputs, whether from a user or more generally from anything outside the trusted system. Input handling acts as a control against numerous risks and is an area ripe for more research and development."@en ;
    dcterms:identifier "componentApplicationInputHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentApplication ;
    cosai:fedBy cosai:componentTheModel .

cosai:componentReasoningCore a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Agent Reasoning Core"@en ;
    rdfs:comment "The core of an agent’s functionality is its ability to reason about a user’s goal and create a plan to achieve it. The reasoning core processes system instructions, user queries, and contextual information to generate a sequence of actions. The actions, or tool calls, allow the agent to affect the real world, interacting with external systems, retrieving new information, or making changes to data and resources. The reasoning core typically consists of one or more models, possibly separate models for the reasoning and then planning steps, or potentially one large model able to do both. The process of planning is often iterative, taking place in a “reasoning loop” where the plan is refined based on new information or the results of previous actions. This iterative nature, combined with the ingestion of external data, creates a vulnerability to indirect prompt injection, where adversarially crafted information can manipulate the agent's planning process. The complexity of plans determines the agent’s level of autonomy, which can range from selecting a predefined workflow to dynamically orchestrating multi-step actions. This level of autonomy directly governs the potential severity of a security failure, the more an agent can do on its own, the greater the risk from manipulation or misalignment. This risk can be, at least partially, mitigated through guardrails that constrain actions taken by an agent; for example, by making certain actions subject to mandatory user confirmation. However, this can in turn result in limitations on the agent's autonomy, thus requiring a careful tradeoff between autonomy and security."@en ;
    dcterms:identifier "componentReasoningCore" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentAgentOutputHandling, cosai:componentOrchestrationInputHandling ;
    cosai:fedBy cosai:componentAgentInputHandling, cosai:componentOrchestrationOutputHandling .

cosai:componentOrchestrationOutputHandling a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Output Handling"@en ;
    rdfs:comment "Orchestration output is responsible for validating, sanitizing, and safely formatting data as it exits the system to external or downstream components. This control ensures outbound data meets defined schemas, strips sensitive information that shouldn't be exposed, prevents injection attacks by properly encoding outputs for their destination context (such as HTML encoding for web responses or parameterization for database queries), and enforces data classification policies."@en ;
    dcterms:identifier "componentOrchestrationOutputHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentReasoningCore, cosai:componentTheModel ;
    cosai:fedBy cosai:componentTools, cosai:componentMemory, cosai:componentRAGContent .

cosai:componentOrchestrationInputHandling a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Input Handling"@en ;
    rdfs:comment "Orchestration input handling is responsible for validating, sanitizing, and normalizing all data entering the system from external sources before it reaches core orchestration logic."@en ;
    dcterms:identifier "componentOrchestrationInputHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentTools, cosai:componentMemory, cosai:componentRAGContent ;
    cosai:fedBy cosai:componentTheModel, cosai:componentReasoningCore .

cosai:componentTools a cosai:ModelComponent, cosai:Component ;
    rdfs:label "External Tools and Services"@en ;
    rdfs:comment "Tools are the external APIs and services an agent uses to take action in the world, which must be secured with least-privilege permissions. A key risk comes from deceptive descriptions on third-party tools, which can trick the agent into performing unintended, harmful functions."@en ;
    dcterms:identifier "componentTools" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentOrchestrationOutputHandling ;
    cosai:fedBy cosai:componentOrchestrationInputHandling .

cosai:componentMemory a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Model Memory"@en ;
    rdfs:comment "Memory allows a model or agent to retain context and learn facts across interactions. Memory implementations may result in additional security and data risk exposures requiring mitigation. Examples include: Persistent attacks: Malicious data stored in memory could enable ongoing attacks against a user. Data loss through improper isolation: Sensitive data may be disclosed due to inadequate memory isolation between different users and contexts. Unintended data transfer: Sensitive information may be inappropriately transferred to third parties through undesired or unexpected tool calls."@en ;
    dcterms:identifier "componentMemory" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentOrchestrationOutputHandling ;
    cosai:fedBy cosai:componentOrchestrationInputHandling .

cosai:componentRAGContent a cosai:ModelComponent, cosai:Component ;
    rdfs:label "Retrieval Augmented Generation & Content"@en ;
    rdfs:comment "Content for Retrieval-Augmented Generation (RAG) provides the agent with curated knowledge to ground its responses and improve accuracy. The main security risk is data poisoning, where an attacker corrupts this knowledge source to manipulate the agent's output."@en ;
    dcterms:identifier "componentRAGContent" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentOrchestrationOutputHandling ;
    cosai:fedBy cosai:componentOrchestrationInputHandling .

cosai:componentAgentUserQuery a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Agent User Query"@en ;
    rdfs:comment "These contain the specific details of a user’s request after being processed. The query is then combined with system instructions and other contextual data, like agent memory or external information, to create a single, structured prompt for the reasoning core to process."@en ;
    dcterms:identifier "componentAgentUserQuery" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentAgentInputHandling .

cosai:componentAgentSystemInstruction a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Agent System Instructions"@en ;
    rdfs:comment "These define an agent’s capabilities, permissions, and limitations, such as the actions it can take and the tools it is allowed to use. For security, it’s critical to unambiguously separate these instructions from user data and other inputs, often using special control tokens as a defense against prompt injection attacks."@en ;
    dcterms:identifier "componentAgentSystemInstruction" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentAgentInputHandling .

cosai:componentAgentInputHandling a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Input Handling"@en ;
    rdfs:comment "An agent’s interaction with the world begins at the User or Application, which serves as the interface for collecting both explicit user instructions and passively collected contextual data from its environment. This blend of inputs creates a primary security challenge of reliably distinguishing trusted commands from the controlling user versus potentially untrusted information from other sources. An agent application processes explicit user instructions, which can be given directly (synchronously) like a typed command, or be configured to execute automatically when a specific event occurs (asynchronously). It also gathers implicit contextual inputs, data that isn’t a direct command but is passively collected from the environment, such as sensor readings, application state, tool call responses or the content of recently opened documents. Input Handling is is responsible for processing and understanding these inputs before they are sent to the agent’s reasoning core. This handoff is a critical security juncture, as the perception layer must reliably distinguish trusted user commands from untrusted data to prevent manipulation of the agent’s core logic."@en ;
    dcterms:identifier "componentAgentInputHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentReasoningCore ;
    cosai:fedBy cosai:componentAgentUserQuery, cosai:componentAgentSystemInstruction, cosai:componentTheModel, cosai:componentApplication .

cosai:componentAgentOutputHandling a cosai:ApplicationComponent, cosai:Component ;
    rdfs:label "Output Handling"@en ;
    rdfs:comment "The final step in an agent’s workflow is response rendering, the process or formatting of an AI agent’s generated output for display and interaction within a user application. This stage is a critical security boundary because it involves taking dynamic content from the agent and displaying it within the trusted context of a user’s application, such as a web browser or mobile application. Flaws in this process can allow malicious content generated by a compromised agent to be executed by the application, leading to significant security breaches. Agents often produce content in a universal format like Markdown, which is then interpreted and rendered by the specific client application. If this output isn’t properly sanitized according to the content type, it can create severe vulnerabilities. For example, unsanitized output can enable data exfiltration when content-embedded resources like images are automatically loaded by the application, implicitly passing sensitive information to an attacker's server via the resource's URL. Similarly, improper sanitization can lead to cross-site scripting (XSS) attacks."@en ;
    dcterms:identifier "componentAgentOutputHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/components.yaml> ;
    cosai:feeds cosai:componentApplication, cosai:componentTheModel ;
    cosai:fedBy cosai:componentReasoningCore .

cosai:riskDataPoisoning a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Data Poisoning"@en ;
    rdfs:comment "Altering data sources used to train the model. In terms of impact, Data Poisoning is comparable to modifying the logic of an application to change its behavior."@en ;
    dcterms:identifier "riskDataPoisoning" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaDataProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlTrainingDataSanitization, cosai:controlSecureByDefaultMLTooling, cosai:controlModelAndDataIntegrityManagement, cosai:controlModelAndDataAccessControls, cosai:controlModelAndDataInventoryManagement ;
    cosai:inLifecycleStage cosai:data_preparation, cosai:model_training, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_reliability, cosai:impact_safety, cosai:impact_fairness ;
    cosai:requiresActorAccess cosai:access_supply_chain, cosai:access_privileged, cosai:access_service_provider, cosai:access_infrastructure_provider .

cosai:riskUnauthorizedTrainingData a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Unauthorized Training Data"@en ;
    rdfs:comment "Using unauthorized data for model training. Using a model trained with Unauthorized Training Data might lead to legal or ethical challenges."@en ;
    dcterms:identifier "riskUnauthorizedTrainingData" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigatedBy cosai:controlTrainingDataSanitization, cosai:controlTrainingDataManagement ;
    cosai:inLifecycleStage cosai:planning, cosai:data_preparation, cosai:model_training ;
    cosai:hasImpactType cosai:impact_compliance, cosai:impact_privacy, cosai:impact_fairness ;
    cosai:requiresActorAccess cosai:access_supply_chain, cosai:access_service_provider .

cosai:riskModelSourceTampering a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Model Source Tampering"@en ;
    rdfs:comment "Tampering with the model's code or data. Model Source Tampering is similar to tampering with traditional software code, and can create vulnerabilities or unintended behavior."@en ;
    dcterms:identifier "riskModelSourceTampering" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlIsolatedConfidentialComputing, cosai:controlModelAndDataAccessControls, cosai:controlModelAndDataExecutionIntegrity, cosai:controlModelAndDataIntegrityManagement, cosai:controlModelAndDataInventoryManagement, cosai:controlSecureByDefaultMLTooling ;
    cosai:inLifecycleStage cosai:development, cosai:model_training, cosai:deployment ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_availability, cosai:impact_safety, cosai:impact_reliability, cosai:impact_compliance ;
    cosai:requiresActorAccess cosai:access_supply_chain, cosai:access_privileged, cosai:access_infrastructure_provider, cosai:access_physical .

cosai:riskExcessiveDataHandling a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Excessive Data Handling"@en ;
    rdfs:comment "Using data for model training and development that exceeds authorized or legal boundaries for collection, retention, or processing. This may lead to policy and legal challenges."@en ;
    dcterms:identifier "riskExcessiveDataHandling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigatedBy cosai:controlTrainingDataManagement, cosai:controlUserTransparencyAndControls ;
    cosai:inLifecycleStage cosai:data_preparation, cosai:model_training, cosai:evaluation ;
    cosai:hasImpactType cosai:impact_privacy, cosai:impact_compliance, cosai:impact_confidentiality ;
    cosai:requiresActorAccess cosai:access_privileged, cosai:access_service_provider .

cosai:riskExcessiveDataHandlingDuringInference a cosai:RuntimeDataSecurityRisk, cosai:Risk ;
    rdfs:label "Excessive Data Handling During Inference"@en ;
    rdfs:comment "Unauthorized collection, retention, processing, or sharing of user data during model inference. This can lead to privacy violations and legal challenges."@en ;
    dcterms:identifier "riskExcessiveDataHandlingDuringInference" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlUserDataManagement, cosai:controlUserTransparencyAndControls ;
    cosai:inLifecycleStage cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_privacy, cosai:impact_compliance, cosai:impact_confidentiality ;
    cosai:requiresActorAccess cosai:access_privileged, cosai:access_service_provider .

cosai:riskModelExfiltration a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Model Exfiltration"@en ;
    rdfs:comment "Theft of a model. Similar to stealing code, this threat has both intellectual property and security implications."@en ;
    dcterms:identifier "riskModelExfiltration" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaModelServing ;
    cosai:mitigatedBy cosai:controlIsolatedConfidentialComputing, cosai:controlModelAndDataInventoryManagement, cosai:controlModelAndDataAccessControls, cosai:controlSecureByDefaultMLTooling, cosai:controlModelAndDataIntegrityManagement ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:model_training, cosai:evaluation, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_privacy ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_privileged, cosai:access_infrastructure_provider, cosai:access_physical, cosai:access_api .

cosai:riskModelDeploymentTampering a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Model Deployment Tampering"@en ;
    rdfs:comment "Unauthorized changes to model deployment components. Model Deployment Tampering can result in changes to model behavior."@en ;
    dcterms:identifier "riskModelDeploymentTampering" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlIsolatedConfidentialComputing, cosai:controlModelAndDataExecutionIntegrity, cosai:controlOrchestratorAndRouteIntegrity, cosai:controlSecureByDefaultMLTooling, cosai:controlInterComponentTransportSecurity ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_availability, cosai:impact_safety ;
    cosai:requiresActorAccess cosai:access_privileged, cosai:access_infrastructure_provider, cosai:access_api, cosai:access_user .

cosai:riskDenialOfMLService a cosai:RuntimeInputSecurityRisk, cosai:Risk ;
    rdfs:label "Denial of ML Service"@en ;
    rdfs:comment "Overloading ML systems with resource-intensive queries. Like traditional DoS attacks, Denial of ML Service can reduce availability of or entirely disrupt a service."@en ;
    dcterms:identifier "riskDenialOfMLService" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlApplicationAccessManagement ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_availability ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user .

cosai:riskModelReverseEngineering a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Model Reverse Engineering"@en ;
    rdfs:comment "Recreating a model by analyzing its inputs, outputs, and behaviors. A reverse engineer model can be used to create imitation products or adversarial attacks."@en ;
    dcterms:identifier "riskModelReverseEngineering" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigatedBy cosai:controlApplicationAccessManagement ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity ;
    cosai:requiresActorAccess cosai:access_api, cosai:access_user .

cosai:riskInsecureIntegratedComponent a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Insecure Integrated Component"@en ;
    rdfs:comment "Software vulnerabilities that can be leveraged to compromise AI models. Insecure Integrated Component can lead to privacy and security concerns, as well as potential ethical and legal challenges."@en ;
    dcterms:identifier "riskInsecureIntegratedComponent" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlAgentPluginPermissions, cosai:controlModelAndDataExecutionIntegrity, cosai:controlUserPoliciesAndEducation, cosai:controlInputValidationAndSanitization, cosai:controlInterComponentTransportSecurity ;
    cosai:inLifecycleStage cosai:development, cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_availability, cosai:impact_safety ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_agent, cosai:access_user .

cosai:riskPromptInjection a cosai:RuntimeInputSecurityRisk, cosai:Risk ;
    rdfs:label "Prompt Injection"@en ;
    rdfs:comment "Tricking a model to run unintended commands. In terms of impact, Prompt Injection can change a model's behavior."@en ;
    dcterms:identifier "riskPromptInjection" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlInputValidationAndSanitization, cosai:controlAdversarialTrainingAndTesting, cosai:controlOutputValidationAndSanitization ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_confidentiality, cosai:impact_safety ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user .

cosai:riskModelEvasion a cosai:RuntimeInputSecurityRisk, cosai:Risk ;
    rdfs:label "Model Evasion"@en ;
    rdfs:comment "Changes to a prompt input to cause the model to produce incorrect inferences. Model Evasion can lead to reputational, legal, security, and privacy risks."@en ;
    dcterms:identifier "riskModelEvasion" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlAdversarialTrainingAndTesting ;
    cosai:inLifecycleStage cosai:evaluation, cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_safety, cosai:impact_reliability ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user .

cosai:riskSensitiveDataDisclosure a cosai:RuntimeDataSecurityRisk, cosai:Risk ;
    rdfs:label "Sensitive Data Disclosure"@en ;
    rdfs:comment "Disclosure of sensitive data by the model. Sensitive Data Disclosure poses a threat to user privacy, organizational reputation, and intellectual property."@en ;
    dcterms:identifier "riskSensitiveDataDisclosure" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaDataProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlModelPrivacyEnhancingTechnologies, cosai:controlRuntimePrivacyEnhancingTechnologies, cosai:controlUserDataManagement, cosai:controlOutputValidationAndSanitization, cosai:controlAdversarialTrainingAndTesting, cosai:controlAgentPluginPermissions, cosai:controlAgentPluginUserControl, cosai:controlAgentObservability, cosai:controlUserTransparencyAndControls, cosai:controlUserPoliciesAndEducation ;
    cosai:inLifecycleStage cosai:model_training, cosai:evaluation, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_privacy ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user, cosai:access_agent, cosai:access_privileged, cosai:access_infrastructure_provider .

cosai:riskInferredSensitiveData a cosai:RuntimeDataSecurityRisk, cosai:Risk ;
    rdfs:label "Inferred Sensitive Data"@en ;
    rdfs:comment "Model inferring personal information not contained in training data or inputs. Inferred Sensitive Data may be considered a data privacy incident."@en ;
    dcterms:identifier "riskInferredSensitiveData" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlTrainingDataManagement, cosai:controlOutputValidationAndSanitization, cosai:controlAdversarialTrainingAndTesting ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_privacy, cosai:impact_fairness ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user .

cosai:riskInsecureModelOutput a cosai:RuntimeOutputSecurityRisk, cosai:Risk ;
    rdfs:label "Insecure Model Output"@en ;
    rdfs:comment "Unvalidated model output passed to the end user. Insecure Model Output poses risks to organizational reputation, security, and user safety."@en ;
    dcterms:identifier "riskInsecureModelOutput" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlOutputValidationAndSanitization, cosai:controlAdversarialTrainingAndTesting ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_safety, cosai:impact_reliability ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user .

cosai:riskRogueActions a cosai:RuntimeOutputSecurityRisk, cosai:Risk ;
    rdfs:label "Rogue Actions"@en ;
    rdfs:comment "Unintended or manipulated model-based actions executed via extensions. Rogue Actions can cascade across systems with severe impact on organizational reputation, user trust, security, and safety."@en ;
    dcterms:identifier "riskRogueActions" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlAgentPluginPermissions, cosai:controlAgentPluginUserControl, cosai:controlOutputValidationAndSanitization, cosai:controlAgentObservability ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_safety, cosai:impact_confidentiality, cosai:impact_availability ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_api, cosai:access_user, cosai:access_agent .

cosai:riskAcceleratorAndSystemSideChannels a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Accelerator and System Side-channels"@en ;
    rdfs:comment "Cross-tenant leakage via hardware side-channels in CPUs, GPUs, TPUs, memory systems, and interconnects. These vulnerabilities exploit timing, cache, speculative execution, and memory access patterns to compromise data confidentiality and infer sensitive information in shared computing environments."@en ;
    dcterms:identifier "riskAcceleratorAndSystemSideChannels" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlSecureByDefaultMLTooling, cosai:controlModelAndDataAccessControls, cosai:controlIsolatedConfidentialComputing .

cosai:riskEconomicDenialOfWallet a cosai:RuntimeInputSecurityRisk, cosai:Risk ;
    rdfs:label "Economic Denial of Wallet"@en ;
    rdfs:comment "Cost abuse via token inflation, long context, or tool loops that spike spend. Economic Denial of Wallet can lead to unexpected financial losses and service disruption through resource exhaustion attacks."@en ;
    dcterms:identifier "riskEconomicDenialOfWallet" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlApplicationAccessManagement, cosai:controlAgentExecutionBounds .

cosai:riskFederatedDistributedTrainingPrivacy a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Federated/Distributed Training Privacy"@en ;
    rdfs:comment "Gradient leakage and inversion attacks from untrusted clients in federated learning. Federated/Distributed Training Privacy risks can expose sensitive training data and compromise participant privacy."@en ;
    dcterms:identifier "riskFederatedDistributedTrainingPrivacy" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaDataProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlModelPrivacyEnhancingTechnologies, cosai:controlRuntimePrivacyEnhancingTechnologies, cosai:controlModelAndDataIntegrityManagement, cosai:controlSecureByDefaultMLTooling .

cosai:riskAdapterPEFTInjection a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Adapter/PEFT Injection"@en ;
    rdfs:comment "Trojaned adapters merged at runtime to bypass safety or exfiltrate data. Adapter/PEFT Injection can compromise model behavior and enable unauthorized access to sensitive information or system resources."@en ;
    dcterms:identifier "riskAdapterPEFTInjection" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlModelAndDataExecutionIntegrity, cosai:controlModelAndDataIntegrityManagement, cosai:controlModelAndDataAccessControls, cosai:controlSecureByDefaultMLTooling .

cosai:riskToolRegistryTampering a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Tool Registry Tampering"@en ;
    rdfs:comment "Compromise of previously vetted tool registries, MCP server manifests, or tool metadata, causing agents to select and invoke unintended tools through altered descriptions, schemas, or shadowed tool names."@en ;
    dcterms:identifier "riskToolRegistryTampering" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaModelServing ;
    cosai:mitigatedBy cosai:controlOrchestratorAndRouteIntegrity, cosai:controlAgentObservability, cosai:controlInterComponentTransportSecurity ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_safety ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_agent, cosai:access_privileged .

cosai:riskOrchestratorRouteHijacking a cosai:RuntimeOutputSecurityRisk, cosai:Risk ;
    rdfs:label "Orchestrator/Route Hijack"@en ;
    rdfs:comment "Silent model or route swaps via configuration tampering or prompt-based routing abuse. Orchestrator/Route Hijack can redirect requests to malicious models or compromise routing integrity in AI systems."@en ;
    dcterms:identifier "riskOrchestratorRouteHijacking" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlIsolatedConfidentialComputing, cosai:controlModelAndDataIntegrityManagement, cosai:controlModelAndDataAccessControls, cosai:controlSecureByDefaultMLTooling, cosai:controlOrchestratorAndRouteIntegrity, cosai:controlInterComponentTransportSecurity .

cosai:riskEvaluationBenchmarkManipulation a cosai:RuntimeDataSecurityRisk, cosai:Risk ;
    rdfs:label "Evaluation/Benchmark Manipulation"@en ;
    rdfs:comment "Poisoned or leaked evaluation sets misleading safety and robustness signals. Evaluation/Benchmark Manipulation can compromise model assessment accuracy and lead to deployment of unsafe or unreliable AI systems."@en ;
    dcterms:identifier "riskEvaluationBenchmarkManipulation" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlModelAndDataIntegrityManagement .

cosai:riskCovertChannelsInModelOutputs a cosai:RuntimeOutputSecurityRisk, cosai:Risk ;
    rdfs:label "Covert Channels in Model Outputs"@en ;
    rdfs:comment "Hidden information transmission through model outputs or behavior patterns. Covert Channels in Model Outputs can enable unauthorized data exfiltration and steganographic communication bypassing security controls."@en ;
    dcterms:identifier "riskCovertChannelsInModelOutputs" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlOutputValidationAndSanitization, cosai:controlModelAndDataIntegrityManagement .

cosai:riskMaliciousLoaderDeserialization a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Malicious Loader/Deserialization"@en ;
    rdfs:comment "Unsafe loaders for models and tokenizers that can cause remote code execution or integrity compromise. Malicious Loader/Deserialization poses significant security risks including system compromise and data breaches."@en ;
    dcterms:identifier "riskMaliciousLoaderDeserialization" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlInputValidationAndSanitization, cosai:controlModelAndDataAccessControls, cosai:controlModelAndDataExecutionIntegrity, cosai:controlModelAndDataIntegrityManagement, cosai:controlSecureByDefaultMLTooling .

cosai:riskToolSourceProvenance a cosai:SupplyChainAndDevelopmentRisk, cosai:Risk ;
    rdfs:label "Tool Source Provenance"@en ;
    rdfs:comment "Use of unvetted or unverified tool registries, MCP server manifests, or tool metadata sources that may provide agents with deceptive tool descriptions, altered schemas, or shadowed tool names."@en ;
    dcterms:identifier "riskToolSourceProvenance" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigatedBy cosai:controlModelAndDataIntegrityManagement, cosai:controlSecureByDefaultMLTooling, cosai:controlAgentPluginPermissions ;
    cosai:inLifecycleStage cosai:development, cosai:deployment ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_safety ;
    cosai:requiresActorAccess cosai:access_supply_chain, cosai:access_agent, cosai:access_external .

cosai:riskPromptResponseCachePoisoning a cosai:RuntimeDataSecurityRisk, cosai:Risk ;
    rdfs:label "Prompt/Response Cache Poisoning"@en ;
    rdfs:comment "Cross-user contamination via shared LLM caches lacking isolation and validation. Prompt/Response Cache Poisoning can lead to information leakage, misinformation propagation, and unauthorized access to cached content."@en ;
    dcterms:identifier "riskPromptResponseCachePoisoning" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaModelServing, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlModelAndDataAccessControls, cosai:controlModelAndDataIntegrityManagement, cosai:controlInputValidationAndSanitization, cosai:controlOutputValidationAndSanitization, cosai:controlUserDataManagement .

cosai:riskRetrievalVectorStorePoisoning a cosai:RuntimeOutputSecurityRisk, cosai:Risk ;
    rdfs:label "Retrieval/Vector Store Poisoning"@en ;
    rdfs:comment "Poisoning retrieval corpora or vector indices to steer RAG outputs. Retrieval/Vector Store Poisoning can compromise the integrity of knowledge retrieval systems and lead to misinformation or malicious content injection."@en ;
    dcterms:identifier "riskRetrievalVectorStorePoisoning" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlTrainingDataSanitization, cosai:controlModelAndDataIntegrityManagement, cosai:controlInputValidationAndSanitization, cosai:controlOutputValidationAndSanitization, cosai:controlRetrievalAndVectorSystemIntegrity .

cosai:riskAgentDelegationChainOpacity a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Agent Delegation Chain Opacity"@en ;
    rdfs:comment "Multi-hop agent delegation chains become opaque when intermediate agents do not emit structured delegation events, making it impossible to determine which human, agent, or system authorized or performed an action , even when individual authentication steps succeed."@en ;
    dcterms:identifier "riskAgentDelegationChainOpacity" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlAgentObservability, cosai:controlAgentIntegrityManagement, cosai:controlAgentInventoryManagement ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_accountability, cosai:impact_compliance, cosai:impact_integrity ;
    cosai:requiresActorAccess cosai:access_agent, cosai:access_privileged .

cosai:riskStaleAgentIdentityBinding a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Stale Agent Identity Binding"@en ;
    rdfs:comment "Agent identity credentials persist unchanged after the underlying model artifact is replaced, allowing a substituted model to operate with the original agent's full permissions because no cryptographic binding ties identity to a specific model version."@en ;
    dcterms:identifier "riskStaleAgentIdentityBinding" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaModelProvider, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlModelAndDataIntegrityManagement, cosai:controlAgentIntegrityManagement, cosai:controlAgentCredentialIsolation, cosai:controlComponentIdentityProvenance ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_confidentiality, cosai:impact_accountability, cosai:impact_compliance ;
    cosai:requiresActorAccess cosai:access_supply_chain, cosai:access_privileged, cosai:access_infrastructure_provider .

cosai:riskMCPTransportHijacking a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "MCP Transport Hijacking"@en ;
    rdfs:comment "Transport-layer attacks on MCP connections , including man-in-the-middle, session hijacking, DNS rebinding, and replay , intercept or modify agent-to-tool communication because the MCP specification does not mandate transport encryption or mutual authentication."@en ;
    dcterms:identifier "riskMCPTransportHijacking" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlSecureByDefaultMLTooling, cosai:controlInterComponentTransportSecurity, cosai:controlComponentIdentityProvenance ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_agent .

cosai:riskShadowAndUnknownAgents a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Shadow and Unknown Agents"@en ;
    rdfs:comment "Unregistered agents operate with inherited or valid credentials outside identity lifecycle controls, creating persistent blind spots in agentic systems."@en ;
    dcterms:identifier "riskShadowAndUnknownAgents" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlSecureByDefaultMLTooling, cosai:controlAgentObservability, cosai:controlAgentInventoryManagement, cosai:controlAgentIntegrityManagement, cosai:controlAgentCredentialIsolation ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_accountability, cosai:impact_compliance ;
    cosai:requiresActorAccess cosai:access_agent, cosai:access_privileged, cosai:access_supply_chain, cosai:access_infrastructure_provider .

cosai:riskRunawayAgentToolLoops a cosai:RuntimeInputSecurityRisk, cosai:Risk ;
    rdfs:label "Runaway Agent Tool Loops"@en ;
    rdfs:comment "Agents enter uncontrolled recursive tool-calling cycles at the orchestration layer, exhausting context windows, compute resources, and API budgets through emergent autonomous behavior or adversarial trigger."@en ;
    dcterms:identifier "riskRunawayAgentToolLoops" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlAgentObservability, cosai:controlAgentExecutionBounds ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_availability, cosai:impact_safety ;
    cosai:requiresActorAccess cosai:access_agent .

cosai:riskAgenticDelegationConfusedDeputy a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Agentic Delegation Confused Deputy"@en ;
    rdfs:comment "A high-privilege agent acts on behalf of a less-privileged caller without validating the caller's authorization at the delegation boundary, allowing the caller to escalate privileges through the deputy's own permissions."@en ;
    dcterms:identifier "riskAgenticDelegationConfusedDeputy" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlSecureByDefaultMLTooling, cosai:controlAgentPluginPermissions, cosai:controlAgentObservability ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_accountability, cosai:impact_compliance ;
    cosai:requiresActorAccess cosai:access_agent, cosai:access_external, cosai:access_user .

cosai:riskCrossTenantCredentialPropagation a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Cross-Tenant Credential Propagation"@en ;
    rdfs:comment "Shared or insufficiently tenant-scoped agent credentials allow a compromise in one tenant to propagate access across tenant boundaries through the identity layer."@en ;
    dcterms:identifier "riskCrossTenantCredentialPropagation" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlSecureByDefaultMLTooling, cosai:controlAgentPluginPermissions, cosai:controlIsolatedConfidentialComputing, cosai:controlAgentCredentialIsolation ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_compliance, cosai:impact_privacy ;
    cosai:requiresActorAccess cosai:access_agent, cosai:access_privileged, cosai:access_infrastructure_provider .

cosai:riskZombieShadowMCPServers a cosai:DeploymentAndInfrastructureRisk, cosai:Risk ;
    rdfs:label "Zombie / Shadow MCP Servers"@en ;
    rdfs:comment "Decommissioned or unregistered MCP servers remain accessible and respond to agent tool calls, allowing attackers to intercept or redirect legitimate requests."@en ;
    dcterms:identifier "riskZombieShadowMCPServers" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/risks.yaml> ;
    cosai:affectsPersona cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider, cosai:personaEndUser ;
    cosai:mitigatedBy cosai:controlAgentObservability, cosai:controlAgentInventoryManagement, cosai:controlInterComponentTransportSecurity, cosai:controlComponentIdentityProvenance ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity ;
    cosai:requiresActorAccess cosai:access_external, cosai:access_supply_chain .

cosai:controlModelPrivacyEnhancingTechnologies a cosai:DataControl, cosai:Control ;
    rdfs:label "Privacy Enhancing Technologies for Model Training"@en ;
    rdfs:comment "Use technologies that minimize, de-identify, or restrict use of PII data in training or evaluating models, including differential privacy, secure aggregation protocols, federated learning, data anonymization, and synthetic data generation."@en ;
    dcterms:identifier "controlModelPrivacyEnhancingTechnologies" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigates cosai:riskSensitiveDataDisclosure, cosai:riskFederatedDistributedTrainingPrivacy ;
    cosai:protects cosai:componentModelTrainingTuning, cosai:componentModelEvaluation .

cosai:controlRuntimePrivacyEnhancingTechnologies a cosai:DataControl, cosai:Control ;
    rdfs:label "Privacy Enhancing Technologies for Inference"@en ;
    rdfs:comment "Use technologies that minimize, de-identify, or restrict use of PII data during model deployment and inference, including secure multi-party computation, homomorphic encryption, inference log de-identification, on-device processing, and privacy-preserving query mechanisms."@en ;
    dcterms:identifier "controlRuntimePrivacyEnhancingTechnologies" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskSensitiveDataDisclosure, cosai:riskFederatedDistributedTrainingPrivacy ;
    cosai:protects cosai:componentApplicationOutputHandling, cosai:componentModelServing .

cosai:controlTrainingDataManagement a cosai:DataControl, cosai:Control ;
    rdfs:label "Training Data Management"@en ;
    rdfs:comment "Ensure that all data used to train and evaluate models is authorized for the intended purposes."@en ;
    dcterms:identifier "controlTrainingDataManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigates cosai:riskInferredSensitiveData, cosai:riskUnauthorizedTrainingData, cosai:riskExcessiveDataHandling ;
    cosai:protects cosai:componentDataSources, cosai:componentTrainingData, cosai:componentModelTrainingTuning, cosai:componentModelEvaluation .

cosai:controlTrainingDataSanitization a cosai:DataControl, cosai:Control ;
    rdfs:label "Training Data Sanitization"@en ;
    rdfs:comment "Detect and remove or remediate poisoned or sensitive data in training and evaluation."@en ;
    dcterms:identifier "controlTrainingDataSanitization" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigates cosai:riskDataPoisoning, cosai:riskUnauthorizedTrainingData, cosai:riskRetrievalVectorStorePoisoning ;
    cosai:protects cosai:componentDataFilteringAndProcessing ;
    cosai:inLifecycleStage cosai:data_preparation, cosai:model_training, cosai:evaluation ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_reliability, cosai:impact_safety, cosai:impact_privacy, cosai:impact_fairness .

cosai:controlUserDataManagement a cosai:DataControl, cosai:Control ;
    rdfs:label "User Data Management"@en ;
    rdfs:comment "Store, process, and use all user data (e.g. prompts and logs) from AI applications in compliance with user consent."@en ;
    dcterms:identifier "controlUserDataManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaDataProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigates cosai:riskSensitiveDataDisclosure, cosai:riskPromptResponseCachePoisoning, cosai:riskExcessiveDataHandlingDuringInference ;
    cosai:protects cosai:componentDataStorage .

cosai:controlModelAndDataInventoryManagement a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Model and Data Inventory Management"@en ;
    rdfs:comment "Ensure that all data, code, models, and transformation tools used in AI applications are inventoried and tracked."@en ;
    dcterms:identifier "controlModelAndDataInventoryManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaDataProvider ;
    cosai:mitigates cosai:riskDataPoisoning, cosai:riskModelSourceTampering, cosai:riskModelExfiltration ;
    cosai:protects cosai:componentModelServing, cosai:componentModelEvaluation, cosai:componentModelTrainingTuning, cosai:componentModelStorage .

cosai:controlModelAndDataAccessControls a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Model and Data Access Controls"@en ;
    rdfs:comment "Minimize internal access to models, weights, datasets, etc. in storage and in production use."@en ;
    dcterms:identifier "controlModelAndDataAccessControls" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaDataProvider, cosai:personaModelServing ;
    cosai:mitigates cosai:riskDataPoisoning, cosai:riskModelSourceTampering, cosai:riskModelExfiltration, cosai:riskAcceleratorAndSystemSideChannels, cosai:riskAdapterPEFTInjection, cosai:riskOrchestratorRouteHijacking, cosai:riskMaliciousLoaderDeserialization, cosai:riskPromptResponseCachePoisoning ;
    cosai:protects cosai:componentModelServing, cosai:componentModelEvaluation, cosai:componentModelTrainingTuning, cosai:componentModelStorage .

cosai:controlModelAndDataIntegrityManagement a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Model and Data Integrity Management"@en ;
    rdfs:comment "Ensure that all data, models, and code used to produce AI models are verifiably integrity-protected during development and deployment. Implement repository trust policies, cryptographic signatures, attestation frameworks, and offline verification capabilities to ensure integrity and authenticity of models and artifacts."@en ;
    dcterms:identifier "controlModelAndDataIntegrityManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaDataProvider, cosai:personaModelServing ;
    cosai:mitigates cosai:riskAdapterPEFTInjection, cosai:riskCovertChannelsInModelOutputs, cosai:riskDataPoisoning, cosai:riskEvaluationBenchmarkManipulation, cosai:riskFederatedDistributedTrainingPrivacy, cosai:riskMaliciousLoaderDeserialization, cosai:riskModelSourceTampering, cosai:riskModelExfiltration, cosai:riskOrchestratorRouteHijacking, cosai:riskPromptResponseCachePoisoning, cosai:riskRetrievalVectorStorePoisoning, cosai:riskToolSourceProvenance, cosai:riskStaleAgentIdentityBinding ;
    cosai:protects cosai:componentModelServing, cosai:componentModelEvaluation, cosai:componentModelTrainingTuning, cosai:componentModelStorage ;
    cosai:inLifecycleStage cosai:data_preparation, cosai:model_training, cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_accountability .

cosai:controlModelAndDataExecutionIntegrity a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Model and Data Execution Integrity"@en ;
    rdfs:comment "Ensure that the code and model results from training and development are of known provenance and lineage and not modified from known-good sources in unexpected ways at inference time. Examples include: Validating expected code and model signatures / hashes at inference-time. Limiting and immutably recording all modifications to runtime AI system components via oversight processes. Other integrity controls appropriate to the deployment context."@en ;
    dcterms:identifier "controlModelAndDataExecutionIntegrity" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing ;
    cosai:mitigates cosai:riskAdapterPEFTInjection, cosai:riskInsecureIntegratedComponent, cosai:riskModelDeploymentTampering, cosai:riskMaliciousLoaderDeserialization, cosai:riskModelSourceTampering ;
    cosai:protects cosai:componentModelServing, cosai:componentModelStorage, cosai:componentTheModel .

cosai:controlSecureByDefaultMLTooling a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Secure-by-Default ML Tooling"@en ;
    rdfs:comment "Use secure-by-default frameworks, libraries, software systems, and hardware components for AI development or deployment to protect confidentiality and integrity of AI assets and outputs."@en ;
    dcterms:identifier "controlSecureByDefaultMLTooling" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskDataPoisoning, cosai:riskModelSourceTampering, cosai:riskModelExfiltration, cosai:riskModelDeploymentTampering, cosai:riskAcceleratorAndSystemSideChannels, cosai:riskFederatedDistributedTrainingPrivacy, cosai:riskAdapterPEFTInjection, cosai:riskOrchestratorRouteHijacking, cosai:riskMaliciousLoaderDeserialization, cosai:riskToolSourceProvenance, cosai:riskMCPTransportHijacking, cosai:riskShadowAndUnknownAgents, cosai:riskAgenticDelegationConfusedDeputy, cosai:riskCrossTenantCredentialPropagation ;
    cosai:protects cosai:componentModelServing, cosai:componentModelTrainingTuning, cosai:componentModelEvaluation, cosai:componentModelStorage ;
    cosai:inLifecycleStage cosai:development, cosai:model_training, cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_availability .

cosai:controlInputValidationAndSanitization a cosai:ModelControl, cosai:Control ;
    rdfs:label "Input Validation and Sanitization"@en ;
    rdfs:comment "Block or restrict adversarial queries to AI models."@en ;
    dcterms:identifier "controlInputValidationAndSanitization" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskPromptInjection, cosai:riskMaliciousLoaderDeserialization, cosai:riskPromptResponseCachePoisoning, cosai:riskRetrievalVectorStorePoisoning, cosai:riskInsecureIntegratedComponent ;
    cosai:protects cosai:componentApplicationInputHandling, cosai:componentAgentInputHandling, cosai:componentOrchestrationInputHandling ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_confidentiality, cosai:impact_safety .

cosai:controlOutputValidationAndSanitization a cosai:ModelControl, cosai:Control ;
    rdfs:label "Output Validation and Sanitization"@en ;
    rdfs:comment "Block, nullify, or sanitize insecure output from AI models before passing it to applications, extensions or users."@en ;
    dcterms:identifier "controlOutputValidationAndSanitization" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelServing, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskPromptInjection, cosai:riskRogueActions, cosai:riskSensitiveDataDisclosure, cosai:riskInferredSensitiveData, cosai:riskCovertChannelsInModelOutputs, cosai:riskPromptResponseCachePoisoning, cosai:riskInsecureModelOutput, cosai:riskRetrievalVectorStorePoisoning ;
    cosai:protects cosai:componentApplicationOutputHandling, cosai:componentAgentOutputHandling, cosai:componentOrchestrationOutputHandling ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_privacy, cosai:impact_safety .

cosai:controlAdversarialTrainingAndTesting a cosai:ModelControl, cosai:Control ;
    rdfs:label "Adversarial Training and Testing"@en ;
    rdfs:comment "Use techniques to make AI models robust to adversarial inputs (i.e. prompts) in the context of their use in applications."@en ;
    dcterms:identifier "controlAdversarialTrainingAndTesting" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskModelEvasion, cosai:riskPromptInjection, cosai:riskSensitiveDataDisclosure, cosai:riskInferredSensitiveData, cosai:riskInsecureModelOutput ;
    cosai:protects cosai:componentTheModel ;
    cosai:inLifecycleStage cosai:model_training, cosai:evaluation, cosai:runtime ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_reliability, cosai:impact_safety .

cosai:controlApplicationAccessManagement a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Application Access and Resource Management"@en ;
    rdfs:comment "Ensure comprehensive access governance through: Identity and authorization controls that restrict resources to authorized users and endpoints for authorized actions. Resource governance controls including usage quotas, rate limiting, cost monitoring, and anomaly detection to prevent resource exhaustion and economic denial of wallet attacks."@en ;
    dcterms:identifier "controlApplicationAccessManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskDenialOfMLService, cosai:riskEconomicDenialOfWallet, cosai:riskModelReverseEngineering ;
    cosai:protects cosai:componentApplication ;
    cosai:inLifecycleStage cosai:runtime ;
    cosai:hasImpactType cosai:impact_availability, cosai:impact_confidentiality .

cosai:controlUserTransparencyAndControls a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "User Transparency and Controls"@en ;
    rdfs:comment "Inform users of relevant AI risks with disclosures, and provide transparency and control experiences for use of their data in AI applications."@en ;
    dcterms:identifier "controlUserTransparencyAndControls" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskSensitiveDataDisclosure, cosai:riskExcessiveDataHandling, cosai:riskExcessiveDataHandlingDuringInference ;
    cosai:protects cosai:componentApplication .

cosai:controlAgentPluginUserControl a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent User Control"@en ;
    rdfs:comment "Ensure user approval for any actions performed by agents/plugins that alter user data or act on the user's behalf."@en ;
    dcterms:identifier "controlAgentPluginUserControl" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaEndUser ;
    cosai:mitigates cosai:riskSensitiveDataDisclosure, cosai:riskRogueActions ;
    cosai:protects cosai:componentReasoningCore .

cosai:controlAgentPluginPermissions a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent Permissions"@en ;
    rdfs:comment "Use least-privilege principle as the upper bound on agentic system permissions to minimize the number of tools that an agent is permitted to interact with and the actions it is allowed to take. An agentic system's use of privileges should be contextual and dynamic, adapting to the specific user query and trusted contextual information. This design also applies to agents that have access to user information. For example, an agent asked to fill out a form or answer questions should share only contextually appropriate information and can be designed to dynamically minimize exposed data using reference monitors. At delegation boundaries, an agent acting on behalf of a caller must verify the caller's authority for the requested action , not rely on the agent's own (often broader) permissions. Each delegation hop should narrow the agent's effective authority to the intersection of its own permissions and the caller's authorization, preventing the agent from being used as a confused deputy to execute actions the caller could not perform directly."@en ;
    dcterms:identifier "controlAgentPluginPermissions" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskInsecureIntegratedComponent, cosai:riskSensitiveDataDisclosure, cosai:riskRogueActions, cosai:riskToolSourceProvenance, cosai:riskAgenticDelegationConfusedDeputy, cosai:riskCrossTenantCredentialPropagation ;
    cosai:protects cosai:componentReasoningCore, cosai:componentTools, cosai:componentRAGContent, cosai:componentMemory ;
    cosai:inLifecycleStage cosai:development, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_safety .

cosai:controlRedTeaming a cosai:AssuranceControl, cosai:Control ;
    rdfs:label "Red Teaming"@en ;
    rdfs:comment "Drive security and privacy improvements through self-driven adversarial attacks on AI infrastructure and products"@en ;
    dcterms:identifier "controlRedTeaming" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaModelProvider, cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskDataPoisoning, cosai:riskUnauthorizedTrainingData, cosai:riskModelSourceTampering, cosai:riskExcessiveDataHandling, cosai:riskExcessiveDataHandlingDuringInference, cosai:riskModelExfiltration, cosai:riskModelDeploymentTampering, cosai:riskDenialOfMLService, cosai:riskModelReverseEngineering, cosai:riskInsecureIntegratedComponent, cosai:riskPromptInjection, cosai:riskModelEvasion, cosai:riskSensitiveDataDisclosure, cosai:riskInferredSensitiveData, cosai:riskInsecureModelOutput, cosai:riskRogueActions, cosai:riskAcceleratorAndSystemSideChannels, cosai:riskEconomicDenialOfWallet, cosai:riskFederatedDistributedTrainingPrivacy, cosai:riskAdapterPEFTInjection, cosai:riskToolRegistryTampering, cosai:riskOrchestratorRouteHijacking, cosai:riskEvaluationBenchmarkManipulation, cosai:riskCovertChannelsInModelOutputs, cosai:riskMaliciousLoaderDeserialization, cosai:riskToolSourceProvenance, cosai:riskPromptResponseCachePoisoning, cosai:riskRetrievalVectorStorePoisoning, cosai:riskAgentDelegationChainOpacity, cosai:riskStaleAgentIdentityBinding, cosai:riskMCPTransportHijacking, cosai:riskShadowAndUnknownAgents, cosai:riskRunawayAgentToolLoops, cosai:riskAgenticDelegationConfusedDeputy, cosai:riskCrossTenantCredentialPropagation, cosai:riskZombieShadowMCPServers ;
    cosai:protects cosai:componentDataSources, cosai:componentDataFilteringAndProcessing, cosai:componentTrainingData, cosai:componentDataStorage, cosai:componentModelFrameworksAndCode, cosai:componentModelEvaluation, cosai:componentModelTrainingTuning, cosai:componentModelStorage, cosai:componentModelServing, cosai:componentTheModel, cosai:componentApplication, cosai:componentApplicationOutputHandling, cosai:componentApplicationInputHandling, cosai:componentReasoningCore, cosai:componentOrchestrationOutputHandling, cosai:componentOrchestrationInputHandling, cosai:componentTools, cosai:componentMemory, cosai:componentRAGContent, cosai:componentAgentUserQuery, cosai:componentAgentSystemInstruction, cosai:componentAgentInputHandling, cosai:componentAgentOutputHandling .

cosai:controlVulnerabilityManagement a cosai:AssuranceControl, cosai:Control ;
    rdfs:label "Vulnerability Management"@en ;
    rdfs:comment "Proactively and continually test and monitor production infrastructure and products for security and privacy regressions"@en ;
    dcterms:identifier "controlVulnerabilityManagement" ;
