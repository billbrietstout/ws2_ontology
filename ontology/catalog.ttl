cosai:controlRiskGovernance a cosai:GovernanceControl, cosai:Control ;
    rdfs:label "Risk Governance"@en ;
    rdfs:comment "Inventory, measure, and monitor residual risk to AI in your organization."@en ;
    dcterms:identifier "controlRiskGovernance" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaGovernance ;
    cosai:mitigates cosai:riskDataPoisoning, cosai:riskUnauthorizedTrainingData, cosai:riskModelSourceTampering, cosai:riskExcessiveDataHandling, cosai:riskExcessiveDataHandlingDuringInference, cosai:riskModelExfiltration, cosai:riskModelDeploymentTampering, cosai:riskDenialOfMLService, cosai:riskModelReverseEngineering, cosai:riskInsecureIntegratedComponent, cosai:riskPromptInjection, cosai:riskModelEvasion, cosai:riskSensitiveDataDisclosure, cosai:riskInferredSensitiveData, cosai:riskInsecureModelOutput, cosai:riskRogueActions, cosai:riskAcceleratorAndSystemSideChannels, cosai:riskEconomicDenialOfWallet, cosai:riskFederatedDistributedTrainingPrivacy, cosai:riskAdapterPEFTInjection, cosai:riskToolRegistryTampering, cosai:riskOrchestratorRouteHijacking, cosai:riskEvaluationBenchmarkManipulation, cosai:riskCovertChannelsInModelOutputs, cosai:riskMaliciousLoaderDeserialization, cosai:riskToolSourceProvenance, cosai:riskPromptResponseCachePoisoning, cosai:riskRetrievalVectorStorePoisoning, cosai:riskAgentDelegationChainOpacity, cosai:riskStaleAgentIdentityBinding, cosai:riskMCPTransportHijacking, cosai:riskShadowAndUnknownAgents, cosai:riskRunawayAgentToolLoops, cosai:riskAgenticDelegationConfusedDeputy, cosai:riskCrossTenantCredentialPropagation, cosai:riskZombieShadowMCPServers .

cosai:controlAgentObservability a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent Observability"@en ;
    rdfs:comment "Ensure an agent's actions, tool use, and reasoning are transparent and auditable through logging, allowing for debugging, security oversight, and user insights into agent activity."@en ;
    dcterms:identifier "controlAgentObservability" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskSensitiveDataDisclosure, cosai:riskRogueActions, cosai:riskToolRegistryTampering, cosai:riskAgentDelegationChainOpacity, cosai:riskShadowAndUnknownAgents, cosai:riskRunawayAgentToolLoops, cosai:riskZombieShadowMCPServers, cosai:riskAgenticDelegationConfusedDeputy ;
    cosai:protects cosai:componentOrchestrationInputHandling, cosai:componentOrchestrationOutputHandling, cosai:componentAgentInputHandling, cosai:componentAgentOutputHandling, cosai:componentReasoningCore .

cosai:controlIsolatedConfidentialComputing a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Isolated and Confidential Computing"@en ;
    rdfs:comment "Use technologies that minimize the risk of 3rd-party access to critical resources via hardware isolation invariants and/or physically isolated computing systems. Examples include including CPU and TPU-based confidential computing technologies (TEEs, secure enclaves), system isolation, secure scheduling, and side-channel monitoring to prevent cross-tenant information leakage."@en ;
    dcterms:identifier "controlIsolatedConfidentialComputing" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskAcceleratorAndSystemSideChannels, cosai:riskModelSourceTampering, cosai:riskModelExfiltration, cosai:riskModelDeploymentTampering, cosai:riskOrchestratorRouteHijacking, cosai:riskCrossTenantCredentialPropagation ;
    cosai:protects cosai:componentModelServing, cosai:componentModelTrainingTuning, cosai:componentMemory, cosai:componentReasoningCore .

cosai:controlRetrievalAndVectorSystemIntegrity a cosai:DataControl, cosai:Control ;
    rdfs:label "Retrieval and Vector System Integrity Management"@en ;
    rdfs:comment "Implement provenance tracking, cryptographic signing, deduplication, embedding anomaly detection, and index integrity checks to protect retrieval systems and vector databases from poisoning attacks."@en ;
    dcterms:identifier "controlRetrievalAndVectorSystemIntegrity" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaDataProvider, cosai:personaPlatformProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskRetrievalVectorStorePoisoning ;
    cosai:protects cosai:componentDataSources, cosai:componentDataStorage, cosai:componentDataFilteringAndProcessing .

cosai:controlOrchestratorAndRouteIntegrity a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Orchestrator and Route Integrity"@en ;
    rdfs:comment "Implement signed route manifests, configuration integrity verification, and response provenance tracking to prevent routing manipulation and ensure request routing to authorized models."@en ;
    dcterms:identifier "controlOrchestratorAndRouteIntegrity" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskOrchestratorRouteHijacking, cosai:riskModelDeploymentTampering, cosai:riskToolRegistryTampering ;
    cosai:protects cosai:componentModelServing, cosai:componentApplication .

cosai:controlAgentInventoryManagement a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent Inventory Management"@en ;
    rdfs:comment "Ensure that all agents operating in the system are registered in a central inventory before credential issuance, with lifecycle state tracking (active, suspended, decommissioned) and automated detection of unregistered agents. This control extends the inventory management concept from {{controlModelAndDataInventoryManagement}} to dynamic, running agent entities. Where model/data inventory tracks static artifacts through build and deployment pipelines, agent inventory tracks entities with operational lifecycle states in a live system. Enforcement includes credential revocation on lifecycle state change and blocking of unregistered agent actions. The same inventory discipline extends to MCP tool server endpoints, providing the lifecycle authority on which runtime provenance and observability controls depend."@en ;
    dcterms:identifier "controlAgentInventoryManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaPlatformProvider, cosai:personaGovernance ;
    cosai:mitigates cosai:riskShadowAndUnknownAgents, cosai:riskZombieShadowMCPServers, cosai:riskAgentDelegationChainOpacity ;
    cosai:protects cosai:componentReasoningCore, cosai:componentTools, cosai:componentOrchestrationInputHandling, cosai:componentOrchestrationOutputHandling ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_accountability, cosai:impact_compliance, cosai:impact_confidentiality, cosai:impact_integrity .

cosai:controlAgentIntegrityManagement a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent Integrity Management"@en ;
    rdfs:comment "Ensure that each running agent's identity and configuration are cryptographically bound to its registered inventory entry and verifiable at runtime. This includes credential binding to individual agent identities (not shared pools), attestation of agent configuration against a registered baseline, and automated revocation propagation on decommission or underlying model swap. This control extends the integrity management concept from {{controlModelAndDataIntegrityManagement}} to agent identity. Where model/data integrity verifies that artifact content (weights, code) has not been tampered with, agent integrity verifies that a running agent's identity credentials match its registered entry. A model can pass artifact integrity checks while the agent wrapping it has drifted from its registered configuration or had its credential bindings compromised."@en ;
    dcterms:identifier "controlAgentIntegrityManagement" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaPlatformProvider, cosai:personaGovernance ;
    cosai:mitigates cosai:riskShadowAndUnknownAgents, cosai:riskStaleAgentIdentityBinding, cosai:riskAgentDelegationChainOpacity ;
    cosai:protects cosai:componentReasoningCore, cosai:componentTools, cosai:componentOrchestrationInputHandling, cosai:componentModelServing ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_accountability, cosai:impact_integrity, cosai:impact_confidentiality .

cosai:controlAgentCredentialIsolation a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent Credential Isolation"@en ;
    rdfs:comment "Ensure that credentials issued to agents are scoped to individual tenants and cannot propagate across tenant boundaries at any point in an orchestration or delegation chain. Implementation requires: per-tenant credential issuance with no shared credential pools across tenant boundaries; short-lived, tenant-scoped tokens for agent-to-tool authentication, with lifetimes bounded to the duration of a single task or session; tenant boundary validation at every MCP protocol hop and delegation step, so that a credential issued in tenant A cannot be forwarded to or reused in tenant B's context; and credential rotation and revocation scoped to tenant context, ensuring that decommissioning an agent in one tenant does not leave credentials valid in another."@en ;
    dcterms:identifier "controlAgentCredentialIsolation" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaPlatformProvider, cosai:personaApplicationDeveloper, cosai:personaGovernance ;
    cosai:mitigates cosai:riskCrossTenantCredentialPropagation, cosai:riskShadowAndUnknownAgents, cosai:riskStaleAgentIdentityBinding ;
    cosai:protects cosai:componentReasoningCore, cosai:componentOrchestrationInputHandling, cosai:componentOrchestrationOutputHandling, cosai:componentTools, cosai:componentMemory ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity, cosai:impact_compliance, cosai:impact_privacy .

cosai:controlInterComponentTransportSecurity a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Inter-Component Transport Security"@en ;
    rdfs:comment "Enforce authenticated, encrypted, and integrity-protected communication channels for all inter-component connections in AI systems, including agent-to-tool, model serving, orchestration, and application API channels. Implement the following transport-layer controls across all component communication paths: TLS/mTLS enforcement: Require TLS 1.2 minimum (TLS 1.3 preferred) for all inter-component connections. Require mutual TLS (mTLS) for machine-to-machine paths , agent-to-tool server, orchestrator-to-model serving endpoint, and application-to-serving API , so that both parties authenticate before any payload is exchanged. Locally-exposed tool server endpoints (e.g., MCP servers on localhost) are in scope and must not be treated as implicitly trusted. Mutual authentication: Each component must present a valid certificate or credential verified against an expected identity before the connection is accepted. This applies to machine-to-machine paths, not user-facing authentication (covered by application access controls). Session token binding: Bind session tokens and API credentials to transport-layer identifiers (e.g., TLS channel binding per RFC 5929) so that a token captured from one TLS session cannot be replayed on a different channel. Replay protection: Apply nonce, timestamp, or sequence number mechanisms to tool invocation requests and inter-component messages carrying side-effecting instructions, preventing captured messages from being reinjected. Origin validation: Validate the origin of requests to locally-exposed endpoints against an allowlist of expected callers, preventing DNS rebinding attacks. Certificate lifecycle management: Issue individual certificates per component identity rather than shared wildcards. Automate certificate rotation before expiry. Revoke certificates immediately on component decommission or credential compromise. It is distinct from {{controlOrchestratorAndRouteIntegrity}} (which governs where traffic is routed), {{controlSecureByDefaultMLTooling}} (which governs tooling selection and configuration), and {{controlIsolatedConfidentialComputing}} (which governs hardware-level compute isolation). Those controls assume secure channels; this control establishes them."@en ;
    dcterms:identifier "controlInterComponentTransportSecurity" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaModelServing, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper ;
    cosai:mitigates cosai:riskMCPTransportHijacking, cosai:riskOrchestratorRouteHijacking, cosai:riskInsecureIntegratedComponent, cosai:riskToolRegistryTampering, cosai:riskModelDeploymentTampering, cosai:riskZombieShadowMCPServers ;
    cosai:protects cosai:componentModelServing, cosai:componentTools, cosai:componentOrchestrationInputHandling, cosai:componentOrchestrationOutputHandling, cosai:componentApplication ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_confidentiality, cosai:impact_integrity .

cosai:controlComponentIdentityProvenance a cosai:InfrastructureControl, cosai:Control ;
    rdfs:label "Component Identity Provenance"@en ;
    rdfs:comment "Ensure that when one component invokes another, the calling component can verify the callee is the currently registered, non-revoked principal for that role , not merely the holder of a key for a domain or network address. This control closes the gap that transport security leaves open: TLS and mTLS prove key possession for an endpoint, but do not attest that the endpoint is the legitimate principal a registry system of record says it should be. Implementation requires: a binding between a component's runtime identity and an authoritative registry entry, such that revocation in the registry is observable to callers within a bounded time window; verification of that binding at invocation time, not solely at channel establishment; and audit telemetry that records the provenance assertion used so post-hoc detection of calls against revoked or expired principals is possible. This control is mechanism-agnostic. Implementers may use SPIFFE/SVIDs, capability tokens, signed registration receipts, mTLS with a private CA whose issuance is gated on registry state, short-lived JWTs from a registration authority, hardware-attested identities, or other approaches that satisfy the intent. The control specifies the question that must be answered at invocation time , \"is this the registered principal?\" , not the cryptographic protocol used to answer it. This control is distinct from {{controlInterComponentTransportSecurity}}, which secures the channel, and from {{controlAgentInventoryManagement}}, which maintains the registry of authorized principals. Inventory is the lifecycle authority; provenance is the runtime attestation that surfaces inventory state to callers; transport is the channel over which both ride."@en ;
    dcterms:identifier "controlComponentIdentityProvenance" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaPlatformProvider, cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaModelServing, cosai:personaGovernance ;
    cosai:mitigates cosai:riskZombieShadowMCPServers, cosai:riskStaleAgentIdentityBinding, cosai:riskMCPTransportHijacking ;
    cosai:protects cosai:componentOrchestrationInputHandling, cosai:componentOrchestrationOutputHandling, cosai:componentTools, cosai:componentModelServing, cosai:componentApplication ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime, cosai:maintenance ;
    cosai:hasImpactType cosai:impact_integrity, cosai:impact_confidentiality, cosai:impact_accountability .

cosai:controlAgentExecutionBounds a cosai:ApplicationControl, cosai:Control ;
    rdfs:label "Agent Execution Bounds"@en ;
    rdfs:comment "Enforce per-agent, per-session, and per-tool-call execution limits at the orchestration layer to prevent runaway tool-calling cycles. Implementation requires: mandatory max_turns defaults for all agent-to-tool execution sequences, with no framework permitting unbounded execution by default; per-agent and per-session tool-call budgets that are enforced by the orchestration layer before each tool invocation; context-window budget tracking that halts agent execution before context saturation degrades reasoning quality; and circuit breakers that terminate agent execution when cumulative resource thresholds (compute, tokens, wall-clock time) are exceeded. Loop detection at the orchestration layer should identify repeated tool-call patterns and trigger early termination."@en ;
    dcterms:identifier "controlAgentExecutionBounds" ;
    dcterms:source <https://github.com/cosai-oasis/secure-ai-tooling/blob/3a896b8a1b2c8f1949cf524a2f2bba349a9cc83a/risk-map/yaml/controls.yaml> ;
    cosai:enactedBy cosai:personaAgenticProvider, cosai:personaApplicationDeveloper, cosai:personaPlatformProvider ;
    cosai:mitigates cosai:riskRunawayAgentToolLoops, cosai:riskEconomicDenialOfWallet ;
    cosai:protects cosai:componentReasoningCore, cosai:componentOrchestrationInputHandling, cosai:componentOrchestrationOutputHandling ;
    cosai:inLifecycleStage cosai:deployment, cosai:runtime ;
    cosai:hasImpactType cosai:impact_availability, cosai:impact_safety .

