@prefix cosai: <https://cosai-oasis.github.io/ontology/cosai-rm#> .
@prefix cre: <https://www.opencre.org/cre/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://cosai-oasis.github.io/ontology/cosai-rm/alignments/frameworks> a owl:Ontology ;
    owl:imports <https://cosai-oasis.github.io/ontology/cosai-rm/catalog> ;
    dcterms:title "CoSAI-RM mappings to ATLAS, NIST AI RMF, STRIDE, OWASP LLM, ISO 22989, and the EU AI Act"@en ;
    rdfs:comment "Framework terms are named individuals. Links use skos:relatedMatch or skos:closeMatch. This graph does not assert owl:equivalentClass."@en .

cosai:frameworkMitreAtlas a cosai:Framework ;
    rdfs:label "Adversarial Threat Landscape for Artificial-Intelligence Systems"@en ;
    rdfs:comment "Knowledge base of adversary tactics and techniques based on real-world attack observations on machine learning systems"@en ;
    dcterms:identifier "mitre-atlas" ;
    rdfs:seeAlso <https://atlas.mitre.org> ;
    owl:versionInfo "5.0.1" .

cosai:frameworkNistAiRmf a cosai:Framework ;
    rdfs:label "NIST Artificial Intelligence Risk Management Framework"@en ;
    rdfs:comment "Framework for managing risks to individuals, organizations, and society associated with artificial intelligence"@en ;
    dcterms:identifier "nist-ai-rmf" ;
    rdfs:seeAlso <https://www.nist.gov/itl/ai-risk-management-framework> ;
    owl:versionInfo "1.0" .

cosai:frameworkStride a cosai:Framework ;
    rdfs:label "STRIDE Threat Model"@en ;
    rdfs:comment "Microsoft threat modeling framework categorizing security threats"@en ;
    dcterms:identifier "stride" ;
    rdfs:seeAlso <https://learn.microsoft.com/en-us/azure/security/develop/threat-modeling-tool-threats> .

cosai:frameworkOwaspLlm a cosai:Framework ;
    rdfs:label "OWASP Top 10 for Large Language Model Applications"@en ;
    rdfs:comment "Top 10 critical security risks for applications using Large Language Models"@en ;
    dcterms:identifier "owasp-top10-llm" ;
    rdfs:seeAlso <https://owasp.org/www-project-top-10-for-large-language-model-applications> ;
    owl:versionInfo "2025" .

cosai:frameworkIso22989 a cosai:Framework ;
    rdfs:label "ISO/IEC 22989 Artificial Intelligence Concepts and Terminology"@en ;
    rdfs:comment "International standard defining AI concepts and terminology including roles and responsibilities"@en ;
    dcterms:identifier "iso-22989" ;
    rdfs:seeAlso <https://www.iso.org/standard/74296.html> ;
    owl:versionInfo "2022" .

cosai:frameworkEuAiAct a cosai:Framework ;
    rdfs:label "European Union Artificial Intelligence Act"@en ;
    rdfs:comment "Legal framework establishing risk-tier requirements for AI systems across the EU, including prohibitions on certain uses, obligations for high-risk systems, and requirements for general-purpose AI models"@en ;
    dcterms:identifier "eu-ai-act" ;
    rdfs:seeAlso <https://digital-strategy.ec.europa.eu/en/policies/regulatory-framework-ai> ;
    owl:versionInfo "2024" .

